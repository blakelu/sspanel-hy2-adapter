ADAPTER_AUTH_TOKEN=replace-with-a-random-token
SSPANEL_BASE_URL=https://panel.example.com
SSPANEL_MU_KEY=replace-with-sspanel-mukey
SSPANEL_NODE_ID=1
HY2_STATS_SECRET=replace-with-a-different-random-secret

# Compose 多实例参数。每个落地实例必须使用独立的项目名、入口端口和配置路径。
HY2_LISTEN_PORT=18445
RELAY_ENV_FILE=.env.hy2-relay
WIREGUARD_CONFIG_DIR=./wireguard-relay
ADAPTER_CONFIG_FILE=./config.docker-hy2-relay.yaml
HYSTERIA_CONFIG_FILE=./hysteria.relay-server.yaml

# WireGuard 健康检查。各 Compose 项目使用独立网络命名空间，默认值可复用。
WG_INTERFACE=wg-relay
WG_ADDRESS=10.77.0.1

# LinuxServer WireGuard 容器文件权限和时区。
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# database 认证模式才需要以下变量。
SSPANEL_DB_HOST=127.0.0.1
SSPANEL_DB_NAME=sspanel
SSPANEL_DB_USER=sspanel_adapter
SSPANEL_DB_PASSWORD=replace-with-database-password
